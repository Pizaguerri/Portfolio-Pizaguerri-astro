
---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<details class="disclosure">
  <summary class="disclosure__heading">{title}</summary>

  <div class="disclosure__content">
    <slot />
  </div>
</details>

<style>
  .disclosure {
    margin: 0;
  }

  .disclosure__heading {
    margin: 0;
    padding: 1rem 0;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--text-1);
    text-transform: uppercase;
    cursor: pointer;
  }

  .disclosure__heading::marker {
    color: var(--text-1);
  }

  .disclosure__content {
    padding: 0 0 1rem;
    color: var(--text-1);
  }

  .disclosure__content p {
    margin-top: 0;
    line-height: 1.6;
  }
</style>
