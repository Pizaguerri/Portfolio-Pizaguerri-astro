
---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import mediaManifest from '../../data/media-manifest.json';
import { mediaUrl } from '../../utils/media.js';

const posts = (await getCollection('blog'))
  .filter((post) => post.id.endsWith('.ca'))
  .sort((a, b) => {
    const dateA = a.data.date?.valueOf() ?? 0;
    const dateB = b.data.date?.valueOf() ?? 0;
    return dateB - dateA;
  });

const postsWithImages = posts.map((post) => {
  const slug = post.id.replace(/\.ca$/, '').trim();

  const cover = mediaManifest.find((image) => {
    const normalizedPath = image.path.toLowerCase();
    const filename = normalizedPath.split('/').pop();

    return (
      normalizedPath.startsWith(`blog/${slug.toLowerCase()}/`) &&
      /^cover\.(jpg|jpeg|png|webp)$/.test(filename)
    );
  });

  return {
    ...post,
    slug,
    image: cover
      ? {
          src: mediaUrl(cover.path),
          width: cover.width,
          height: cover.height,
        }
      : null,
  };
});
---

<BaseLayout title="Editorial | Pablo Izaguerri">
  <div class="site-container" style="padding-top: 0; padding-bottom: 4rem;">

    <header class="selected-header">
      <h1>Editorial</h1>
    </header>

    <div
      id="blog-index-gallery"
      class="justified-grid justified-gallery"
    >
      {postsWithImages.map((post) => (
        post.image && (
          <a
            href={`/blog/${post.slug}`}
            class="grid-item gallery-item"
          >
            <img
              src={post.image.src}
              alt={post.data.title}
              width={post.image.width}
              height={post.image.height}
              loading="lazy"
            />
          </a>
        )
      ))}
    </div>

  </div>
</BaseLayout>

<script>
  import { initJustifiedGallery } from '../../scripts/gallery.js';

  let cleanupGallery = null;

  function initGallery() {
    cleanupGallery?.();
    cleanupGallery = null;

    const gallery = document.getElementById('blog-index-gallery');

    if (!gallery) return;

    cleanupGallery = initJustifiedGallery(gallery, {
      itemSelector: '.gallery-item',
      targetRowHeight: 288,
      spacing: 8,
      heightTolerance: 0.25,
    });
  }

  document.addEventListener('astro:before-swap', () => {
    cleanupGallery?.();
    cleanupGallery = null;
  });

  document.addEventListener('astro:page-load', initGallery);

  initGallery();
</script>
