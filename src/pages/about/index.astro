
---
import { getEntry, getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AboutImage from '../../components/AboutImage.astro';
import { buildCV } from '../../utils/cv';
import CVCategory from '../../components/CVCategory.astro';

const aboutEntry = await getEntry('about', 'index.ca');
const aboutAfterEntry = await getEntry('about', 'index-after.ca');

if (!aboutEntry) {
  throw new Error("No s'ha trobat el fitxer index.ca.md");
}

if (!aboutAfterEntry) {
  throw new Error("No s'ha trobat el fitxer index-after.ca.md");
}

const { Content: AboutContent } = await render(aboutEntry);
const { Content: AboutAfterContent } = await render(aboutAfterEntry);

// Recuperar el CV manual
const manualCVEntry = await getEntry('about', 'cv.ca');
const manualCV = manualCVEntry?.data;

// Recuperar proyectos y entradas del blog
const projects = await getCollection('projects');
const blogPosts = await getCollection('blog');

// Excluir borradores
const allEntries = [
  ...projects,
  ...blogPosts,
].filter((entry) => !entry.data.draft);

// Construir el CV combinado
const fullCV = buildCV(allEntries, manualCV);
---

<BaseLayout title="Sobre jo | Pablo Izaguerri" lang="ca">
  <div
    class="content-container"
    style="padding-top: 4rem; padding-bottom: 4rem;"
  >
    <div class="prose">
      <AboutContent
        components={{
          img: AboutImage,
        }}
      />

      <div class="about-cv">
        <CVCategory
          category="exposicions"
          items={fullCV.exposicions}
          lang="ca"
        />
        <CVCategory
          category="publicacions_i_col·laboracions"
          items={fullCV.publicacions_i_col·laboracions}
          lang="ca"
        />
        <CVCategory
          category="premis"
          items={fullCV.premis}
          lang="ca"
        />
      </div>

      <AboutAfterContent
        components={{
          img: AboutImage,
        }}
      />
    </div>
  </div>
</BaseLayout>

<style>
  .about-cv {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin: 3rem 0;
  }
</style>
