---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';

const aboutEntry = await getEntry('about', 'index.ca');

if (!aboutEntry) {
  throw new Error("No s'ha trobat el fitxer index.ca.md");
}

const { Content } = await render(aboutEntry);
---

<BaseLayout title="Sobre jo | Pablo Izaguerri" lang="ca">
  <div class="content-container" style="padding-top: 4rem; padding-bottom: 4rem;">
    

    <div class="prose">
      <Content 
        components={{ 
          img: (props) => <Image {...props} widths={[800, 1200]} sizes="(max-width: 800px) 100vw, 800px" style="width: 100%; height: auto; border-radius: 0; margin: 2rem 0;" />
        }} 
      />
    </div>
  </div>
</BaseLayout>