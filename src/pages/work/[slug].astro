
---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Expos from '../../components/expos.astro';
import Disclosure from '../../components/Disclosure.astro';
import Tags from '../../components/Tags.astro';
import { useTranslations } from '../../i18n/utils.js';
import mediaManifest from '../../data/media-manifest.json';
import { mediaUrl } from '../../utils/media.js';

const t = useTranslations('ca');

export async function getStaticPaths() {
  const works = await getCollection('work');

  return works.map((work) => ({
    params: { slug: work.id.trim() },
    props: { work },
  }));
}

const { work } = Astro.props;
const { Content } = await render(work);

const slug = work.id.trim().toLowerCase();
const isGallery = work.data.type === 'gallery';

const englishSummary = work.data.summary_en?.trim();

const workImages = mediaManifest.filter((image) =>
  image.path.toLowerCase().startsWith(`work/${slug}/`)
);

const isCover = (path) => {
  const fileName = path.split('/').pop().toLowerCase();

  return [
    'cover.jpg',
    'cover.jpeg',
    'cover.png',
    'cover.webp',
  ].includes(fileName);
};

const galleryImages = workImages
  .filter((image) => isGallery || !isCover(image.path))
  .sort((a, b) =>
    a.path.localeCompare(b.path, undefined, { numeric: true })
  )
  .map((image) => ({
    ...image,
    url: mediaUrl(image.path),
  }));

const sliderImages = galleryImages;

function getMarkdownImage(props) {
  const rawSrc = typeof props.src === 'string'
    ? props.src
    : props.src?.src ?? '';

  const normalizedSrc = decodeURIComponent(
    rawSrc.split(/[?#]/)[0]
  ).replace(/\\/g, '/');

  const workPrefix = `work/${slug}/`;

  const relativeSrc = normalizedSrc
    .replace(/^\/+/, '')
    .replace(/^.*\/work\//i, 'work/');

  const image = workImages.find((item) => {
    const normalizedPath = item.path.toLowerCase();
    const normalizedRelativeSrc = relativeSrc.toLowerCase();

    if (normalizedRelativeSrc.startsWith(workPrefix)) {
      return normalizedPath === normalizedRelativeSrc;
    }

    const filename = normalizedRelativeSrc.split('/').pop();

    return normalizedPath.endsWith(`/${filename}`);
  });

  if (!image) {
    const filename = normalizedSrc.split('/').pop();

    throw new Error(
      `No se encontró en el manifiesto la imagen Markdown "${filename}" del proyecto "${slug}".`
    );
  }

  return {
    src: mediaUrl(image.path),
    width: image.width,
    height: image.height,
  };
}
---

<BaseLayout
  title={`${work.data.title} | Pablo Izaguerri`}
  description={work.data.description}
>
  {isGallery ? (
    <div id="work-gallery-container">
      <div
        class="site-container"
        style="padding-top: 0; padding-bottom: 4rem;"
      >
        <header class="selected-header">
          <h1>{work.data.title}</h1>
        </header>

        <div
          id="pure-work-gallery"
          class="justified-gallery"
          data-pswp-active="true"
        >
          {galleryImages.map((img) => (
            <a
              href={img.url}
              class="post-gallery-item gallery-item work-mosaic-item"
              data-pswp-width={img.width}
              data-pswp-height={img.height}
            >
              <img
                src={img.url}
                alt=""
                width={img.width}
                height={img.height}
                loading="lazy"
              />
            </a>
          ))}
        </div>
      </div>
    </div>
  ) : (
    <>
      <div id="work-gallery-container">
        <div
          class="slider-container"
          id="slider-container"
          data-pswp-active="true"
        >
          <div class="slider-track" id="slider-track">
            {sliderImages.map((img, index) => (
              <a
                href={img.url}
                class="slider-item"
                data-pswp-width={img.width}
                data-pswp-height={img.height}
              >
                <img
                  src={img.url}
                  alt=""
                  width={img.width}
                  height={img.height}
                  loading={index === 0 ? 'eager' : 'lazy'}
                />
              </a>
            ))}
          </div>
        </div>

        <div
          class="mosaic-container"
          id="mosaic-container"
          data-pswp-active="false"
          style="display: none;"
        >
          <div
            class="site-container"
            style="padding-top: 2rem; padding-bottom: 2rem;"
          >
            <div
              id="work-mosaic-gallery"
              class="justified-gallery"
            >
              {galleryImages.map((img) => (
                <a
                  href={img.url}
                  class="post-gallery-item gallery-item work-mosaic-item"
                  data-pswp-width={img.width}
                  data-pswp-height={img.height}
                >
                  <img
                    src={img.url}
                    alt=""
                    width={img.width}
                    height={img.height}
                    loading="lazy"
                  />
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>

      <div class="content-container">
        <article class="work-layout">
          <aside class="work-sidebar">
            <div class="sidebar-header">
              <h1>{work.data.title}</h1>

              <button
                id="toggle-gallery-btn"
                class="toggle-gallery-btn"
                aria-label="Alternar vista"
                aria-pressed="false"
                title="Ver galería/mosaico"
                type="button"
              >
                <svg
                  id="icon-grid"
                  xmlns="http://www.w3.org/2000/svg"
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <rect x="3" y="3" width="7" height="7"></rect>
                  <rect x="14" y="3" width="7" height="7"></rect>
                  <rect x="14" y="14" width="7" height="7"></rect>
                  <rect x="3" y="14" width="7" height="7"></rect>
                </svg>

                <svg
                  id="icon-slider"
                  style="display: none;"
                  xmlns="http://www.w3.org/2000/svg"
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <rect
                    x="3"
                    y="3"
                    width="18"
                    height="18"
                    rx="2"
                    ry="2"
                  ></rect>
                </svg>
              </button>
            </div>

            {work.data.date && (
              <span class="work-year">
                {work.data.date.getFullYear()}
              </span>
            )}

            <Tags tags={work.data.tags} />

            <Expos
              cv={work.data.cv}
              lang="ca"
            />

            {englishSummary && (
              <Disclosure title={t('englishSummary')}>
                <p>{englishSummary}</p>
              </Disclosure>
            )}
          </aside>

          <div class="work-main">
            <p class="work-summary">
              {work.data.description}
            </p>

            <div class="prose">
              <Content
                components={{
                  img: (props) => {
                    const image = getMarkdownImage(props);

                    return (
                      <img
                        src={image.src}
                        alt={props.alt ?? ''}
                        title={props.title}
                        width={image.width}
                        height={image.height}
                        loading="lazy"
                        style="width: 100%; height: auto; border-radius: 0; margin: 2rem 0;"
                      />
                    );
                  },
                }}
              />
            </div>
          </div>
        </article>
      </div>
    </>
  )}
</BaseLayout>

<style>
  #work-gallery-container {
    width: 100%;
    margin-bottom: 3rem;
  }

  .slider-container {
    width: 100%;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .slider-container::-webkit-scrollbar {
    display: none;
  }

  .slider-track {
    display: flex;
    height: 70vh;
    align-items: center;
  }

  .slider-item {
    flex: 0 0 100%;
    height: 100%;
    scroll-snap-align: center;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 2rem;
    box-sizing: border-box;
    cursor: zoom-in;
    text-decoration: none;
  }

  .slider-item img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .justified-gallery {
    position: relative;
    width: 100%;
  }

  .work-mosaic-item {
    display: block;
    cursor: zoom-in;
  }

  .work-mosaic-item img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .sidebar-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }

  .work-sidebar h1 {
    font-size: 2.5rem;
    font-weight: 600;
    line-height: 1.1;
    margin: 0;
    color: var(--text-1);
  }

  .toggle-gallery-btn {
    background: transparent;
    border: 1px solid var(--border);
    color: var(--text-1);
    padding: 0.5rem;
    cursor: pointer;
    border-radius: 4px;
    transition: all 0.2s;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .toggle-gallery-btn:hover {
    background: var(--surface-2);
  }

  .work-layout {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 4rem;
    padding: 2rem 0 6rem;
  }

  .work-sidebar {
    position: sticky;
    top: 6rem;
    align-self: start;
  }

  .work-year {
    display: block;
    font-size: 1.1rem;
    color: var(--text-2);
    margin-bottom: 2rem;
  }

  .work-summary {
    font-size: 1.5rem;
    line-height: 1.5;
    margin-top: 0;
    margin-bottom: 3rem;
    color: var(--text-1);
    font-weight: 500;
  }

  @media (max-width: 900px) {
    .work-layout {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding-bottom: 4rem;
    }

    .work-sidebar {
      position: static;
    }

    .slider-track {
      height: 50vh;
    }

    .slider-item {
      padding: 1rem;
    }

    .work-summary {
      font-size: 1.2rem;
    }

    .sidebar-header {
      flex-direction: row;
      align-items: center;
    }

    .work-sidebar h1 {
      font-size: 2rem;
    }
  }
</style>

<script>
  import { initJustifiedGallery } from '../../scripts/gallery.js';

  let cleanupGallery = null;
  let toggleHandler = null;

  function setActiveView(isMosaic) {
    const sliderContainer = document.getElementById('slider-container');
    const mosaicContainer = document.getElementById('mosaic-container');
    const iconGrid = document.getElementById('icon-grid');
    const iconSlider = document.getElementById('icon-slider');
    const toggleBtn = document.getElementById('toggle-gallery-btn');

    if (
      !sliderContainer ||
      !mosaicContainer ||
      !iconGrid ||
      !iconSlider ||
      !toggleBtn
    ) {
      return;
    }

    sliderContainer.style.display = isMosaic ? 'none' : 'block';
    mosaicContainer.style.display = isMosaic ? 'block' : 'none';

    sliderContainer.dataset.pswpActive = String(!isMosaic);
    mosaicContainer.dataset.pswpActive = String(isMosaic);

    iconGrid.style.display = isMosaic ? 'none' : 'block';
    iconSlider.style.display = isMosaic ? 'block' : 'none';

    toggleBtn.setAttribute('aria-pressed', String(isMosaic));

    cleanupGallery?.();
    cleanupGallery = null;

    if (isMosaic) {
      const gallery = document.getElementById('work-mosaic-gallery');

      if (gallery) {
        cleanupGallery = initJustifiedGallery(gallery, {
          itemSelector: '.gallery-item',
          targetRowHeight: 288,
          spacing: 8,
          heightTolerance: 0.25,
        });
      }
    }
  }

  function initworkGallery() {
    const pureGallery = document.getElementById('pure-work-gallery');

    if (pureGallery) {
      cleanupGallery?.();
      cleanupGallery = initJustifiedGallery(pureGallery, {
        itemSelector: '.gallery-item',
        targetRowHeight: 288,
        spacing: 8,
        heightTolerance: 0.25,
      });
      return;
    }

    const gallery = document.getElementById('work-mosaic-gallery');

    if (!gallery) return;

    cleanupGallery?.();
    cleanupGallery = null;

    const toggleBtn = document.getElementById('toggle-gallery-btn');

    if (!toggleBtn) return;

    if (toggleHandler) {
      toggleBtn.removeEventListener('click', toggleHandler);
    }

    toggleHandler = () => {
      const mosaicContainer = document.getElementById('mosaic-container');

      if (!mosaicContainer) return;

      const isMosaicVisible =
        mosaicContainer.dataset.pswpActive === 'true';

      setActiveView(!isMosaicVisible);

      window.scrollTo({
        top: 0,
        behavior: 'smooth',
      });
    };

    toggleBtn.addEventListener('click', toggleHandler);

    setActiveView(false);
  }

  function cleanupworkGallery() {
    cleanupGallery?.();
    cleanupGallery = null;

    const toggleBtn = document.getElementById('toggle-gallery-btn');

    if (toggleBtn && toggleHandler) {
      toggleBtn.removeEventListener('click', toggleHandler);
    }

    toggleHandler = null;
  }

  document.addEventListener('astro:page-load', initworkGallery);
  document.addEventListener('astro:before-swap', cleanupworkGallery);

  initworkGallery();
</script>
