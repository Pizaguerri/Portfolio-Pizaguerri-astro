
---
import BaseLayout from '../layouts/BaseLayout.astro';
import mediaManifest from '../data/media-manifest.json';
import { mediaUrl } from '../utils/media.js';

const selectedItems = mediaManifest
  .filter((image) => image.path.toLowerCase().startsWith('selected/'))
  .sort((a, b) => a.path.localeCompare(b.path))
  .map((image) => ({
    ...image,
    url: mediaUrl(image.path),
  }));
---

<BaseLayout title="Selected Works | Pablo Izaguerri">
  <div
    class="site-container"
    style="padding-top: 0; padding-bottom: 4rem; position: relative; z-index: 1;"
  >
    <header class="selected-header">
      <h1>Senzills</h1>
    </header>

    <div
      class="justified-grid justified-gallery"
      id="post-gallery"
    >
      {selectedItems.map((item) => (
        <a
          href={item.url}
          class="grid-item post-gallery-item gallery-item"
          data-pswp-width={item.width}
          data-pswp-height={item.height}
        >
          <img
            src={item.url}
            alt=""
            width={item.width}
            height={item.height}
            loading="lazy"
          />
        </a>
      ))}
    </div>
  </div>
</BaseLayout>

<script>
  import { initJustifiedGallery } from '../scripts/gallery.js';

  let cleanupGallery = null;

  function initGallery() {
    cleanupGallery?.();
    cleanupGallery = null;

    const gallery = document.getElementById('post-gallery');

    if (!gallery) return;

    cleanupGallery = initJustifiedGallery(gallery, {
      itemSelector: '.gallery-item',
      targetRowHeight: 288,
      spacing: 8,
      heightTolerance: 0.25,
    });
  }

  document.addEventListener('astro:before-swap', () => {
    cleanupGallery?.();
    cleanupGallery = null;
  });

  document.addEventListener('astro:page-load', initGallery);

  initGallery();
</script>
