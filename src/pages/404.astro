---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
// Importamos la imagen desde la carpeta public (no necesita optimización de Astro)
// Si quieres usar el componente Image, cámbialo por una ruta normal.
---

<BaseLayout title="404 - Página no encontrada">
  <div class="site-container" style="display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 70vh; text-align: center;">
    
    <img src="/images/404.jpg" alt="404 Not Found" style="max-width: 100%; width: 800px; height: auto; border-radius: 0px; margin-bottom: 1rem;" />

  </div>
</BaseLayout>