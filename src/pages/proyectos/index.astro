---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';

const projects = (await getCollection('projects'))
  .filter(p => p.id.endsWith('.ca'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const projectsWithImages = projects.map((p) => {
  const slug = p.id.replace('.ca', '');
  const images = import.meta.glob('../../content/projects/**/*.{jpg,jpeg,png,webp}', { eager: true });
  const imgs = Object.keys(images).filter(k => k.includes(`/projects/${slug}/`)).map(k => images[k].default);
  imgs.sort((a, b) => a.src.includes('cover') ? -1 : (b.src.includes('cover') ? 1 : 0));
  return { ...p, slug, image: imgs[0] };
});
---

<BaseLayout title="Projectes | Pablo Izaguerri">
  <div class="site-container" style="padding-top: 0; padding-bottom: 4rem;">
    
    <header class="selected-header">
      <h1>Projectes</h1>
    </header>

    <div class="justified-grid">
      {projectsWithImages.map((project) => (
        <a href={`/proyectos/${project.slug}`} class="grid-item">
          {project.image && (
            <Image 
              src={project.image} 
              alt={project.data.title} 
              widths={[400, 800, 1200]} 
              sizes="(max-width: 1200px) 50vw, 33vw" 
            />
          )}
        </a>
      ))}
    </div>
  </div>
</BaseLayout>